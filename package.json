{
  "name": "@keak/webmcp-core",
  "version": "0.2.0",
  "description": "Auto-generate WebMCP tool definitions from any website",
  "author": "Keak <support@keak.com> (https://keak.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/keak-resources/webmcp-core.git"
  },
  "bugs": {
    "url": "https://github.com/keak-resources/webmcp-core/issues"
  },
  "homepage": "https://github.com/keak-resources/webmcp-core#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "webmcp",
    "mcp",
    "model-context-protocol",
    "browser-tools",
    "ai-tools",
    "web-scraping",
    "automation",
    "tool-generation"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "webmcp": "./bin/webmcp.mjs"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit",
"prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "chalk": "^5.6.2",
    "ora": "^8.2.0",
    "uuid": "^11.0.0",
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "playwright": "^1.49.0",
    "playwright-core": "^1.49.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/uuid": "^10.0.0",
    "playwright-core": "^1.49.0",
    "typescript": "^5.7.0"
  },
  "files": [
    "dist",
    "bin",
    "LICENSE",
    "README.md"
  ]
}
